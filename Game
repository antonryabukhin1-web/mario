</div>

<!-- RESULT -->
<div id="resultScreen">
  <div class="res-logo">
    <div class="res-logo-shapes">
      <div class="res-shape-tri"></div>
      <div class="res-shape-circ"></div>
      <div class="res-shape-sq"></div>
    </div>
    <div class="res-logo-text">.ру банк</div>
  </div>
  <div class="res-player-badge">Результат игры</div>
  <div class="result-name" id="resName">—</div>
  <div class="result-score-block">
    <div class="result-score-label">Набрано очков</div>
    <div class="result-score-num" id="resScore">0</div>
    <div class="result-score-pts">баллов</div>
    <div class="result-tries-info" id="resTries"></div>
  </div>
