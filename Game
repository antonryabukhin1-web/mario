<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Дом.ру Runner</title>
<style>
* { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }

body {
  background: #E8380D;
  min-height: 100vh;
  font-family: 'Arial Black', 'Arial Bold', Arial, sans-serif;
  overflow: hidden;
  touch-action: manipulation;
}

#screen {
  max-width: 430px;
  margin: 0 auto;
  height: 100dvh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

/* ---- REGISTRATION ---- */
#regScreen {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20px 20px 16px;
  z-index: 100;
  background: linear-gradient(160deg, #FF6A00 0%, #E8380D 40%, #C8290A 100%);
}

.domru-logo {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 10px;
}
.domru-logo-shapes { display: flex; gap: 3px; align-items: center; }
.domru-shape-tri { width:0; height:0; border-left:9px solid transparent; border-right:9px solid transparent; border-bottom:16px solid #fff; }
.domru-shape-circ { width:16px; height:16px; border-radius:50%; background:#fff; }
.domru-shape-sq { width:16px; height:16px; background:#fff; }
.domru-logo-text { font-size:22px; font-weight:900; color:#fff; letter-spacing:-0.5px; }

.game-title {
  font-size: 34px;
  font-weight: 900;
  color: #fff;
  text-align: center;
  line-height: 1.1;
  margin-bottom: 4px;
  text-shadow: 3px 3px 0 rgba(0,0,0,0.25);
}
.game-subtitle {
  font-size: 13px;
  color: rgba(255,255,255,0.85);
  text-align: center;
  margin-bottom: 18px;
  font-weight: 400;
  font-family: Arial, sans-serif;
}

.prizes-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 7px;
  margin-bottom: 18px;
  width: 100%;
}
.prize-item {
  background: rgba(0,0,0,0.18);
  border: 1.5px solid rgba(255,255,255,0.25);
  border-radius: 12px;
  padding: 8px 4px 6px;
  text-align: center;
  font-size: 10px;
  color: rgba(255,255,255,0.9);
  line-height: 1.3;
  font-family: Arial, sans-serif;
}
.prize-item .pi-icon { font-size:24px; display:block; margin-bottom:4px; }
.prize-item .pi-pts { font-size:15px; font-weight:900; color:#FFD700; display:block; }
.prize-item .pi-name { font-size:9px; color:rgba(255,255,255,0.8); }
.prize-item.special { background:rgba(255,215,0,0.2); border-color:#FFD700; }
.prize-item.special .pi-label { font-size:8px; color:#FFD700; font-weight:900; display:block; margin-top:2px; }

.reg-form {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.reg-form label {
  font-size: 11px;
  color: rgba(255,255,255,0.8);
  text-transform: uppercase;
  letter-spacing: 1.5px;
  font-family: Arial, sans-serif;
  font-weight: 700;
}
.reg-form input {
  width: 100%;
  padding: 14px 16px;
  border-radius: 12px;
  border: 2px solid rgba(255,255,255,0.4);
  background: rgba(255,255,255,0.15);
  color: #fff;
  font-size: 17px;
  font-family: Arial, sans-serif;
  outline: none;
  transition: border-color 0.2s, background 0.2s;
}
.reg-form input::placeholder { color:rgba(255,255,255,0.45); }
.reg-form input:focus { border-color:#FFD700; background:rgba(255,255,255,0.22); }

.btn-start {
  width: 100%;
  padding: 17px;
  border-radius: 14px;
  border: none;
  background: #fff;
  color: #E8380D;
  font-size: 18px;
  font-weight: 900;
  font-family: 'Arial Black', Arial, sans-serif;
  letter-spacing: 1px;
  cursor: pointer;
  margin-top: 2px;
  box-shadow: 0 5px 0 rgba(0,0,0,0.25), 0 8px 20px rgba(0,0,0,0.2);
  transform: translateY(0);
  transition: transform 0.1s, box-shadow 0.1s;
}
.btn-start:active { transform:translateY(5px); box-shadow:0 0 0 rgba(0,0,0,0.25); }

/* ---- GAME ---- */
#gameScreen {
  position: absolute;
  inset: 0;
  display: none;
  flex-direction: column;
}

#hud {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 16px 6px;
  background: linear-gradient(180deg, rgba(200,41,10,1) 0%, rgba(180,30,5,1) 100%);
  z-index: 10;
  flex-shrink: 0;
  border-bottom: 2px solid rgba(255,255,255,0.18);
}
.hud-item { text-align:center; }
.hud-label { font-size:9px; color:rgba(255,255,255,0.7); letter-spacing:1.5px; text-transform:uppercase; font-family:Arial,sans-serif; }
.hud-value { font-size:22px; font-weight:900; color:#fff; line-height:1.1; font-family:'Arial Black',Arial,sans-serif; }
#timerVal { color:#FFD700; }
.hud-name { font-size:12px; color:#FFD700; font-weight:900; max-width:95px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-family:Arial,sans-serif; }
.try-dots { display:flex; gap:4px; justify-content:center; margin-top:3px; }
.try-dot { width:9px; height:9px; border-radius:50%; background:#fff; box-shadow:0 0 4px rgba(255,255,255,0.5); }
.try-dot.used { background:rgba(255,255,255,0.25); box-shadow:none; }

#canvas { flex:1; width:100%; display:block; touch-action:none; }

/* ---- RESULT ---- */
#resultScreen {
  position: absolute;
  inset: 0;
  display: none;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 20px 16px 24px;
  background: linear-gradient(160deg, #FF6A00 0%, #E8380D 40%, #C8290A 100%);
  overflow-y: auto;
  z-index: 50;
}

.res-logo { display:flex; align-items:center; gap:6px; margin-bottom:14px; }
.res-logo-shapes { display:flex; gap:2px; align-items:center; }
.res-shape-tri { width:0; height:0; border-left:7px solid transparent; border-right:7px solid transparent; border-bottom:12px solid #fff; }
.res-shape-circ { width:12px; height:12px; border-radius:50%; background:#fff; }
.res-shape-sq { width:12px; height:12px; background:#fff; }
.res-logo-text { font-size:16px; font-weight:900; color:#fff; }

.res-player-badge {
  background: rgba(0,0,0,0.2);
  border: 1.5px solid rgba(255,255,255,0.3);
  border-radius: 100px;
  padding: 5px 18px;
  font-size: 13px;
  color: rgba(255,255,255,0.85);
  margin-bottom: 6px;
  font-family: Arial, sans-serif;
}
.result-name {
  font-size: 22px;
  font-weight: 900;
  color: #fff;
  text-align: center;
  margin-bottom: 10px;
  font-family: 'Arial Black', Arial, sans-serif;
  text-shadow: 2px 2px 0 rgba(0,0,0,0.2);
}

.result-score-block {
  background: rgba(0,0,0,0.2);
  border: 2.5px solid rgba(255,255,255,0.4);
  border-radius: 18px;
  padding: 16px 32px;
  margin: 0 0 12px;
  text-align: center;
  width: 100%;
}
.result-score-label { font-size:10px; color:rgba(255,255,255,0.75); letter-spacing:2px; text-transform:uppercase; font-family:Arial,sans-serif; }
.result-score-num { font-size:58px; font-weight:900; color:#FFD700; line-height:1; font-family:'Arial Black',Arial,sans-serif; text-shadow:3px 3px 0 rgba(0,0,0,0.2); }
.result-score-pts { font-size:13px; color:rgba(255,255,255,0.7); font-family:Arial,sans-serif; }
.result-tries-info { font-size:11px; color:rgba(255,255,255,0.6); margin-top:4px; font-family:Arial,sans-serif; }

.result-items { width:100%; margin:0 0 12px; }
.result-items-title { font-size:10px; color:rgba(255,255,255,0.7); text-align:center; letter-spacing:1.5px; margin-bottom:8px; font-family:Arial,sans-serif; text-transform:uppercase; }
.collected-grid { display:grid; grid-template-columns:1fr 1fr; gap:7px; }
.collected-item {
  background: rgba(0,0,0,0.18);
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 10px;
  padding: 8px 10px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.collected-item .ci-icon { font-size:24px; line-height:1; }
.collected-item .ci-info { flex:1; min-width:0; }
.collected-item .ci-name { font-size:10px; color:rgba(255,255,255,0.85); line-height:1.3; font-family:Arial,sans-serif; }
.collected-item .ci-count { font-size:14px; font-weight:900; color:#FFD700; font-family:'Arial Black',Arial,sans-serif; }
.collected-item.zero { opacity:0.3; }
.collected-item.special-item { border-color:#FFD700; }

.screenshot-hint {
  background: rgba(255,215,0,0.18);
  border: 1.5px solid rgba(255,215,0,0.5);
  border-radius: 14px;
  padding: 12px 16px;
  text-align: center;
  margin: 0 0 10px;
  width: 100%;
}
.screenshot-hint p { font-size:13px; color:#FFD700; line-height:1.5; font-family:Arial,sans-serif; }
.screenshot-hint strong { font-weight:900; }

.result-btns { display:flex; gap:10px; width:100%; }
.btn-again {
  flex: 1;
  padding: 16px;
  border-radius: 14px;
  border: none;
  background: #fff;
  color: #E8380D;
  font-size: 16px;
  font-weight: 900;
  font-family: 'Arial Black', Arial, sans-serif;
  cursor: pointer;
  box-shadow: 0 4px 0 rgba(0,0,0,0.25);
  transform: translateY(0);
  transition: transform 0.1s, box-shadow 0.1s;
}
.btn-again:active { transform:translateY(4px); box-shadow:0 0 0 rgba(0,0,0,0.25); }

#leaderboard { width:100%; margin:10px 0 0; }
.lb-title { font-size:10px; color:rgba(255,255,255,0.7); text-align:center; letter-spacing:1.5px; margin-bottom:8px; font-family:Arial,sans-serif; text-transform:uppercase; }
.lb-row {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  background: rgba(0,0,0,0.15);
  border-radius: 9px;
  margin-bottom: 4px;
  border: 1px solid transparent;
}
.lb-row.me { border-color:rgba(255,255,255,0.4); background:rgba(0,0,0,0.25); }
.lb-rank { font-size:14px; font-weight:900; color:#FFD700; min-width:22px; font-family:'Arial Black',Arial; }
.lb-pname { flex:1; font-size:13px; color:#fff; font-family:Arial,sans-serif; }
.lb-pscore { font-size:15px; font-weight:900; color:#FFD700; font-family:'Arial Black',Arial; }

/* ---- COUNTDOWN ---- */
#countdown {
  position: absolute;
  inset: 0;
  display: none;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  z-index: 30;
  background: rgba(200,41,10,0.88);
}
#countdown .cd-num {
  font-size: 110px;
  font-weight: 900;
  color: #fff;
  font-family: 'Arial Black', Arial, sans-serif;
  text-shadow: 5px 5px 0 rgba(0,0,0,0.2);
  animation: cdPop 0.8s ease-out;
  line-height: 1;
}
#countdown .cd-text { font-size:16px; color:rgba(255,255,255,0.85); margin-top:10px; font-family:Arial,sans-serif; letter-spacing:2px; text-transform:uppercase; }
@keyframes cdPop {
  0% { transform:scale(2.2); opacity:0; }
  60% { transform:scale(0.92); opacity:1; }
  100% { transform:scale(1); }
}

.flash { position:absolute; inset:0; pointer-events:none; z-index:20; opacity:0; }
.flash.active { animation:flashAnim 0.2s ease-out; }
@keyframes flashAnim {
  0% { opacity:0.5; background:#FFD700; }
  100% { opacity:0; }
}
</style>
</head>
<body>
<div id="screen">

<!-- REGISTRATION -->
<div id="regScreen">
  <div class="domru-logo">
    <div class="domru-logo-shapes">
      <div class="domru-shape-tri"></div>
      <div class="domru-shape-circ"></div>
      <div class="domru-shape-sq"></div>
    </div>
