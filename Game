</div>

<!-- GAME -->
<div id="gameScreen">
  <div id="hud">
    <div class="hud-item">
      <div class="hud-label">Игрок</div>
      <div class="hud-name" id="hudName">—</div>
      <div class="try-dots" id="tryDots"></div>
    </div>
    <div class="hud-item">
      <div class="hud-label">Очки</div>
